# Non-secret environment defaults for Vite / Wrangler local runs.
# Copy secrets to `.dev.vars` (which is gitignored) — never commit secrets here.

APP_NAME=Postlet
APP_VERSION=0.6.1
DEFAULT_AI_MODEL=@cf/meta/llama-3.2-3b-instruct
# Outbound provider selector: "resend" (default) | "cloudflare" | "ses"
MAIL_PROVIDER=resend
